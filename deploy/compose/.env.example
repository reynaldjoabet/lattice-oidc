# Copy to .env (never commit it) and restrict it: chmod 600 .env
# Generate each secret separately, for example: openssl rand -hex 32

# Public host name. Its DNS record must point at this host (Caddy gets the certificate).
LATTICE_DOMAIN=login.example.com
ACME_EMAIL=ops@example.com

# The image built by `sbt --client Docker/publishLocal`, or a pushed one, ideally pinned by digest.
LATTICE_IMAGE=lattice-oidc:0.1.0-SNAPSHOT

# Signs session cookies. Changing it signs everyone out.
APPLICATION_SECRET=
# Keys pairwise subject identifiers. Never change it: every pairwise "sub" would change.
PAIRWISE_SECRET=
# Encrypts authenticator-app secrets. To rotate, see SECOND_FACTOR_PREVIOUS_ENCRYPTION_KEYS.
SECOND_FACTOR_ENCRYPTION_KEY=

AUTHLETE_BASE_URL=https://us.authlete.com
AUTHLETE_SERVICE_APIKEY=
AUTHLETE_SERVICE_ACCESSTOKEN=

# The introspection client "rs0" (lattice.resource-servers). Its built-in default is public.
RS0_SECRET=

DATABASE_PASSWORD=
REDIS_PASSWORD=
# Bearer token Prometheus sends to /metrics.
METRICS_TOKEN=
GRAFANA_ADMIN_PASSWORD=

# Comma-separated login IDs allowed into the operator console (/admin). Empty disables it.
ADMIN_LOGIN_IDS=

# Without SMTP_HOST, emails (password reset, verification) are only written to the log.
MAIL_FROM="Lattice <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Replaces the JVM defaults; keep both flags when adding others.
# LATTICE_JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
