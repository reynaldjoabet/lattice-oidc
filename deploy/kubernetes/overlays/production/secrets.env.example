# Copy to secrets.env (never commit it): chmod 600 secrets.env
# Generate each secret separately, for example: openssl rand -hex 32

# Signs session cookies. Changing it signs everyone out.
APPLICATION_SECRET=
# Keys pairwise subject identifiers. Never change it: every pairwise "sub" would change.
PAIRWISE_SECRET=
# Encrypts authenticator-app secrets.
SECOND_FACTOR_ENCRYPTION_KEY=

AUTHLETE_SERVICE_APIKEY=
AUTHLETE_SERVICE_ACCESSTOKEN=

# The introspection client "rs0" (lattice.resource-servers). Its built-in default is public.
RS0_SECRET=

DATABASE_PASSWORD=
# rediss:// for TLS. The password goes in the URL.
REDIS_URL=rediss://:password@redis.example.internal:6379

# Bearer token Prometheus sends to /metrics (servicemonitor.yaml reads it from this Secret).
METRICS_TOKEN=

SMTP_USERNAME=
SMTP_PASSWORD=
