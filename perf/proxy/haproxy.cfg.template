# Generated by perf/run.sh. HAProxy in front of the Lattice servers, set up as it would be in production,
# apart from TLS (see the comments marked "production"). Each setting says why it is there.
global
  maxconn 100000
  # Threads: left to HAProxy, which detects the usable CPUs (it prints a notice when nbthread is set
  # below that count). Set "nbthread N" (PROXY_THREADS=N in perf/run.sh) only to leave cores for other
  # processes on a shared machine.
  __NBTHREAD_LINE__
  # Stop cleanly on a reload or a SIGUSR1 soft-stop: in-flight requests finish, up to 30 s.
  hard-stop-after 30s
  # production: log to syslog/stdout (log stdout format raw local0 info) and add "option httplog".
  #             Logging costs throughput, so the load test leaves it off.

defaults
  mode http

  # --- Timeouts: long enough for Lattice (an Authlete call allows 10 s), short enough to shed trouble.
  timeout connect       3s
  timeout client        30s
  timeout server        30s
  # A client has this long to send its request headers: stops slow-header (slowloris) connections.
  timeout http-request  10s
  timeout http-keep-alive 60s
  # With a server's maxconn reached, a request waits this long for a free slot, then gets a 503.
  timeout queue         10s
  timeout check         3s

  option http-keep-alive

  # --- A request whose connection failed never reached a server, so it is safe to send it to another
  # one. Nothing else is retried here: a connection that died after the request was sent may already
  # have been processed (a sign-in, a code issued), and sending it again could repeat that.
  option redispatch
  retries 3
  retry-on conn-failure

frontend public
  bind 127.0.0.1:__PUBLIC_PORT__
  # production: bind :443 ssl crt /etc/haproxy/certs/ alpn h2,http/1.1 (HTTP/2 to clients, HTTP/1.1 to Lattice)
  #             http-request redirect scheme https unless { ssl_fc }
  #             http-request set-header X-Forwarded-Proto https if { ssl_fc }

  # Not public: Prometheus scrapes each server directly.
  http-request deny deny_status 404 if { path /metrics } || { path_beg /metrics/ }

  # The client's address, replacing anything the client sent, so Lattice's logs, audit trail and
  # per-IP limits never see a made-up value. (Play takes the rightmost untrusted address, so an
  # appended value wouldn't fool it either; this keeps the header clean for everything else.)
  http-request set-header X-Forwarded-For %[src]

  default_backend lattice

backend lattice
  # Fewest open connections: a server busy with slow Argon2 sign-ins gets fewer new requests.
  balance __BALANCE__

  # Reuse connections to the servers across clients: far fewer connections opened (and TIME_WAIT
  # sockets) than one per client connection. "safe" is the manual's recommended mode: a client's first
  # request always gets its own connection, so a request is never re-sent on a connection that another
  # client may have used. "aggressive" is for clients that can retry a failed request, and writes
  # (sign-ins, codes) can't be retried safely.
  http-reuse safe

  # Liveness, not readiness-of-dependencies: /health/live says the process serves requests. A server is out
  # after 2 failed checks (about 2 s), back after 3 good ones, and checked every 250 ms while unsure.
  # No "observe layer7": it would mark servers down on 5xx answers, and during an Authlete outage
  # every server answers 503, so it would take them all out at once.
  option httpchk
  http-check send meth GET uri /health/live ver HTTP/1.1 hdr Host localhost
  http-check expect status 200

  # slowstart: a server that has just started or come back gets a growing share of traffic over 10 s,
  #            because a cold JVM is slow until its code is compiled.
  # maxconn:   at most this many concurrent requests per server; more wait in HAProxy's queue
  #            instead of piling onto Lattice's threads.
  # No on-marked-down shutdown-sessions: the manual reserves it for checks that find a stuck backend
  #            with connections that can't be reused. Here it would also cut sign-ins that were about to
  #            finish on a server that is only slow to answer the check.
  default-server check inter 1s fastinter 250ms downinter 2s fall 2 rise 3 slowstart 10s maxconn 2000
__SERVERS__
