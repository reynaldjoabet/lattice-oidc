# Routes
# This file defines all application routes (Higher priority routes first)
# ~~~~

# An example controller showing a sample home page
GET     /                           controllers.HomeController.index()

# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)

# Health probes
GET     /health/live                com.lattice.oidc.controllers.HealthController.live()
GET     /health/ready               com.lattice.oidc.controllers.HealthController.ready()

# Authorization (RFC 6749 / OIDC Core)
GET     /api/authorization                          com.lattice.oidc.controllers.AuthorizationController.get(request: Request)
+ nocsrf
POST    /api/authorization                          com.lattice.oidc.controllers.AuthorizationController.post(request: Request)
POST    /api/authorization/decision                 com.lattice.oidc.controllers.AuthorizationController.decision(request: Request)

# OpenID Federation and login via external OpenID Providers
GET     /.well-known/openid-federation              com.lattice.oidc.controllers.FederationController.configuration()
+ nocsrf
POST    /api/federation/register                    com.lattice.oidc.controllers.FederationController.register(request: Request)
GET     /api/federation/initiation/:id              com.lattice.oidc.controllers.FederationController.initiation(request: Request, id: String, ticket: String)
GET     /api/federation/callback/:id                com.lattice.oidc.controllers.FederationController.callback(request: Request, id: String)

# Token endpoint (RFC 6749, 8693, 7523, OIDC Native SSO)
+ nocsrf
POST    /api/token                                  com.lattice.oidc.controllers.TokenController.token(request: Request)

# Discovery and keys
GET     /.well-known/openid-configuration           com.lattice.oidc.controllers.DiscoveryController.configuration(request: Request)
GET     /.well-known/oauth-authorization-server     com.lattice.oidc.controllers.DiscoveryController.configuration(request: Request)
GET     /api/jwks                                   com.lattice.oidc.controllers.DiscoveryController.jwks()
GET     /.well-known/apple-app-site-association     com.lattice.oidc.controllers.DiscoveryController.appleAppSiteAssociation()

# UserInfo, introspection, revocation, PAR, grant management, attestation
GET     /api/userinfo                               com.lattice.oidc.controllers.UserInfoController.get(request: Request)
+ nocsrf
POST    /api/userinfo                               com.lattice.oidc.controllers.UserInfoController.post(request: Request)
+ nocsrf
POST    /api/introspection                          com.lattice.oidc.controllers.IntrospectionController.introspect(request: Request)
+ nocsrf
POST    /api/revocation                             com.lattice.oidc.controllers.RevocationController.revoke(request: Request)
+ nocsrf
POST    /api/par                                    com.lattice.oidc.controllers.PushedAuthorizationController.push(request: Request)
GET     /api/gm/:grantId                            com.lattice.oidc.controllers.GrantManagementController.query(request: Request, grantId: String)
+ nocsrf
DELETE  /api/gm/:grantId                            com.lattice.oidc.controllers.GrantManagementController.revoke(request: Request, grantId: String)
+ nocsrf
POST    /api/challenge                              com.lattice.oidc.controllers.AttestationController.challenge()

# Dynamic client registration (RFC 7591 / 7592)
+ nocsrf
POST    /api/register                               com.lattice.oidc.controllers.ClientRegistrationController.register(request: Request)
GET     /api/register/:id                           com.lattice.oidc.controllers.ClientRegistrationController.read(request: Request, id: String)
+ nocsrf
PUT     /api/register/:id                           com.lattice.oidc.controllers.ClientRegistrationController.update(request: Request, id: String)
+ nocsrf
DELETE  /api/register/:id                           com.lattice.oidc.controllers.ClientRegistrationController.delete(request: Request, id: String)

# Open Banking Brasil resource APIs
+ nocsrf
POST    /api/obb/consents                           com.lattice.oidc.controllers.ObbController.createConsent(request: Request)
GET     /api/obb/consents/:consentId                com.lattice.oidc.controllers.ObbController.readConsent(request: Request, consentId: String)
+ nocsrf
DELETE  /api/obb/consents/:consentId                com.lattice.oidc.controllers.ObbController.deleteConsent(request: Request, consentId: String)
GET     /api/obb/accounts                           com.lattice.oidc.controllers.ObbController.accounts(request: Request)
GET     /api/obb/fapi2base-accounts                 com.lattice.oidc.controllers.ObbController.fapi2BaseAccounts(request: Request)
GET     /api/obb/resources                          com.lattice.oidc.controllers.ObbController.resources(request: Request)

# Diagnostics (lattice.test-endpoints.enabled)
GET     /api/test/headers                           com.lattice.oidc.controllers.TestController.headers(request: Request)
GET     /api/test/obb                               com.lattice.oidc.controllers.TestController.obb(request: Request)

# CIBA (OpenID Connect Client-Initiated Backchannel Authentication)
+ nocsrf
POST    /api/backchannel/authentication             com.lattice.oidc.controllers.CibaController.authenticate(request: Request)
+ nocsrf
POST    /api/backchannel/authentication/callback    com.lattice.oidc.controllers.CibaController.callback(request: Request)

# Device authorization grant (RFC 8628)
+ nocsrf
POST    /api/device/authorization                   com.lattice.oidc.controllers.DeviceController.authorization(request: Request)
GET     /api/device/verification                    com.lattice.oidc.controllers.DeviceController.verificationPage(request: Request)
POST    /api/device/verification                    com.lattice.oidc.controllers.DeviceController.verify(request: Request)
POST    /api/device/complete                        com.lattice.oidc.controllers.DeviceController.complete(request: Request)

# OpenID for Verifiable Credential Issuance
GET     /.well-known/openid-credential-issuer       com.lattice.oidc.controllers.CredentialController.metadata()
GET     /.well-known/jwt-issuer                     com.lattice.oidc.controllers.CredentialController.jwtIssuer()
GET     /.well-known/jwt-vc-issuer                  com.lattice.oidc.controllers.CredentialController.jwtIssuer()
GET     /api/vci/jwks                               com.lattice.oidc.controllers.CredentialController.jwks()
+ nocsrf
POST    /api/credential                             com.lattice.oidc.controllers.CredentialController.credential(request: Request)
+ nocsrf
POST    /api/batch_credential                       com.lattice.oidc.controllers.CredentialController.batch(request: Request)
+ nocsrf
POST    /api/deferred_credential                    com.lattice.oidc.controllers.CredentialController.deferred(request: Request)
+ nocsrf
POST    /api/nonce                                  com.lattice.oidc.controllers.CredentialController.nonce()
GET     /api/offer/issue                            com.lattice.oidc.controllers.CredentialOfferController.form(request: Request)
POST    /api/offer/issue                            com.lattice.oidc.controllers.CredentialOfferController.create(request: Request)
GET     /api/offer/:identifier                      com.lattice.oidc.controllers.CredentialController.offer(identifier: String)

# RP-Initiated Logout 1.0 / Back-Channel Logout 1.0
GET     /api/logout                                 com.lattice.oidc.controllers.LogoutController.get(request: Request)
+ nocsrf
POST    /api/logout                                 com.lattice.oidc.controllers.LogoutController.post(request: Request)
POST    /api/logout/confirm                         com.lattice.oidc.controllers.LogoutController.confirm(request: Request)
